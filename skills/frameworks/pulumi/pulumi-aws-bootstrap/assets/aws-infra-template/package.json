{
  "name": "[project]",
  "main": "index.ts",
  "scripts": {
    "pulumi:deploy:staging": "pulumi up --stack staging",
    "pulumi:login:staging": "pulumi login s3://[project]-pulumi-staging",
    "pulumi:secret:set:staging": "pulumi config set <secret:id> <value> --secret --stack staging"
  },
  "dependencies": {
    "@pulumi/aws": "^7.0.0",
    "@pulumi/awsx": "^3.0.0",
    "@pulumi/pulumi": "^3.113.0"
  },
  "devDependencies": {
    "@types/node": "^18",
    "typescript": "^5.0.0"
  }
}
